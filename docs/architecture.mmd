flowchart TB
    subgraph CLI["CLI / Composition Root (current)"]
        Main["cli/main.py<br/>argparse · exit codes · cleanup"]
        Repl["cli/repl.py<br/>commands · persistence"]
        Comp["cli/composition.py<br/>tools · KB · MCP wiring"]
    end

    subgraph APP["Application"]
        Agent["Agent facade<br/>184 lines"]
        RunTurn["application/run_turn.py<br/>ReAct loop"]
        Context["application/context.py<br/>domain/context_policy.py"]
        ToolExec["application/tool_executor.py<br/>execution + observation"]
        McpTools["application/mcp_tools.py<br/>MCP tool bridge"]
        KbApp["rag/knowledge.py<br/>ingest · query orchestration"]
    end

    subgraph PORTS["Ports"]
        StorePort["RuntimeStore"]
        LLMPort["LLMClient"]
        TransportPort["MCPTransport"]
    end

    subgraph ADAPTERS["Adapters"]
        MySQLStore["adapters/memory/mysql_store.py"]
        SQLiteStore["adapters/memory/sqlite_store.py"]
        OpenAI["adapters/llm/openai_compatible.py"]
        McpAdapter["adapters/mcp/client.py + knowledge_server.py"]
        KnowledgeAdapter["adapters/knowledge/*"]
    end

    subgraph CORE["Domain / Protocol"]
        Contracts["tools/contracts.py + registry"]
        Prompt["SYSTEM_PROMPT + JSON repair"]
        RagModels["rag/models.py + loaders.py + chunking.py"]
        Framing["protocol/mcp_framing.py"]
        Events["observability/events.py"]
    end

    subgraph EXTERNAL["External systems"]
        MySQL[("MySQL 8")]
        Chroma[("Chroma (optional)")]
        LLM["DeepSeek / OpenAI-compatible"]
        McpServers["External MCP servers"]
    end

    Main --> Comp
    Comp --> Repl
    Repl --> Agent
    Comp --> Agent
    Comp --> KbApp
    Comp --> McpTools
    Agent --> RunTurn
    RunTurn --> Context
    RunTurn --> ToolExec
    RunTurn --> Events
    RunTurn --> LLMPort
    RunTurn --> Contracts
    ToolExec --> Contracts
    Agent --> Events
    Agent --> Contracts
    KbApp --> RagModels
    McpTools --> TransportPort
    Repl --> StorePort
    StorePort -. implemented by .-> MySQLStore
    StorePort -. implemented by .-> SQLiteStore
    LLMPort -. implemented by .-> OpenAI
    TransportPort -. implemented by .-> McpAdapter
    KbApp --> KnowledgeAdapter
    KnowledgeAdapter --> MySQL
    KnowledgeAdapter -. optional .-> Chroma
    OpenAI --> LLM
    McpAdapter --> McpServers
    Framing -. used by .-> McpAdapter

