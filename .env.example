# DeepSeek API Key（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL 主存储（ADR-001；与 docker-compose.yml 一致）
# 未设置时 CLI 默认尝试 127.0.0.1:3306 的 MySQL
AGENTKERNEL_DB_URL=mysql+pymysql://agentkernel:change-this-agent-password@127.0.0.1:3306/agentkernel
# 知识库存储 DSN；本地无 MySQL 时可改为 sqlite:////tmp/agentkernel-kb
AGENTKERNEL_KB_DSN=mysql+pymysql://agentkernel:change-this-agent-password@127.0.0.1:3306/agentkernel

# Docker Compose MySQL credentials（仅本地开发示例，请替换为强密码）
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PASSWORD=change-this-agent-password
